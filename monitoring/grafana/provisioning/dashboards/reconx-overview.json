{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "API request rate by endpoint (ADV087)",
      "datasource": { "type": "prometheus", "uid": "reconx-prometheus" },
      "targets": [
        { "expr": "sum(rate(http_server_requests_seconds_count[1m])) by (uri)", "legendFormat": "{{uri}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "API P95 latency (ADV088)",
      "datasource": { "type": "prometheus", "uid": "reconx-prometheus" },
      "targets": [
        { "expr": "1000 * histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket[1m])) by (le, uri))", "legendFormat": "{{uri}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Open recon breaks (ADV091)",
      "datasource": { "type": "prometheus", "uid": "reconx-prometheus" },
      "targets": [{ "expr": "recon_break_count" }],
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 8 }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Trades created / sec (ADV089)",
      "datasource": { "type": "prometheus", "uid": "reconx-prometheus" },
      "targets": [{ "expr": "sum(rate(trade_created_total[1m]))" }],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 6, "y": 8 }
    },
    {
      "id": 5,
      "type": "heatmap",
      "title": "Reconciliation duration histogram (ADV090)",
      "description": "Reconciliation duration distribution. X-axis: time. Y-axis: Prometheus le bucket boundary in seconds. Acceptance query: sum(rate(reconciliation_duration_seconds_bucket[5m])) by (le).",
      "datasource": { "type": "prometheus", "uid": "reconx-prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "scaleDistribution": { "type": "linear" }
          }
        },
        "overrides": []
      },
      "options": {
        "calculate": true,
        "cellGap": 1,
        "color": {
          "exponent": 0.5,
          "fill": "dark-orange",
          "mode": "scheme",
          "reverse": false,
          "scale": "exponential",
          "scheme": "Spectral",
          "steps": 64
        },
        "filterValues": { "le": 1e-9 },
        "legend": { "show": true },
        "rowsFrame": { "layout": "auto" },
        "selectionMode": "x",
        "showValue": "never",
        "tooltip": { "mode": "single", "showColorScale": false, "yHistogram": false },
        "yAxis": {
          "axisLabel": "Bucket boundary (le, seconds)",
          "axisPlacement": "left",
          "decimals": 3,
          "reverse": false,
          "unit": "s"
        }
      },
      "pluginVersion": "11.2.0",
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "reconx-prometheus" },
        "expr": "sum(rate(reconciliation_duration_seconds_bucket[5m])) by (le)",
        "format": "heatmap",
        "legendFormat": "{{le}}",
        "refId": "A"
      }],
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 }
    },
    {
      "id": 6,
      "type": "row",
      "title": "Kafka",
      "collapsed": false,
      "panels": [],
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 24 }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Consumer lag by topic",
      "datasource": { "type": "prometheus", "uid": "reconx-prometheus" },
      "targets": [
        {
          "expr": "sum by (topic) (kafka_consumer_records_lag or kafka_consumer_fetch_manager_records_lag)",
          "legendFormat": "{{topic}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 100 },
              { "color": "red", "value": 1000 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 25 }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Throughput: produced vs consumed",
      "datasource": { "type": "prometheus", "uid": "reconx-prometheus" },
      "targets": [
        {
          "expr": "sum(rate(kafka_consumer_records_consumed_total[1m]) or rate(kafka_consumer_fetch_manager_records_consumed_total[1m]))",
          "legendFormat": "consumed",
          "refId": "A"
        },
        {
          "expr": "sum(rate(kafka_producer_record_send_total[1m]))",
          "legendFormat": "produced",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "msg/s" },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 25 }
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["reconx"],
  "templating": { "list": [] },
  "time": { "from": "now-15m", "to": "now" },
  "title": "ReconX Overview",
  "uid": "reconx-overview",
  "version": 1
}
