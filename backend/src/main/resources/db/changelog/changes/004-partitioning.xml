<?xml version="1.0" encoding="UTF-8"?>
<!--
 ============================================================================
 TICKET-ADV007 — Monthly partitioning of trades on Postgres
 WHAT:    Convert trades into a range-partitioned parent on trade_date and
          create partitions for the current rolling 12 months.
 HOW:     Postgres-only via raw SQL. The trainer guide for Day 1 documents
          the "rename, recreate as partitioned, copy data" pattern that
          students must run if production data already exists. In this clean
          starter we recreate trades directly since there's nothing to copy.
 WHY:     500-million-row trades table would kill EXPLAIN; monthly partitions
          give predictable prune-by-date plans.
 OBSERVE: \d+ trades shows "Partitioned table" + 12 child partitions.
 ============================================================================
-->
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <!-- Demonstration only: the partitioning conversion is destructive and is
         taught in the trainer guide Day-1 Sprint 0B. In this starter we
         create a single partition for the rolling-current-month so the
         seed data has somewhere to land. -->
    <changeSet id="004-partition-parent-table" author="trainer">
        <preConditions onFail="MARK_RAN">
            <dbms type="postgresql"/>
        </preConditions>
        <!-- Drop the non-partitioned trades created by 002-create-trades and
             recreate as a RANGE-partitioned parent on trade_date. Safe at this
             point in the changelog because 008-seed has not run yet, so there
             is no data to preserve. The composite PRIMARY KEY (id, trade_date)
             is required by Postgres: the partition column must be part of every
             unique constraint. settlements is created below as 004-create-settlements
             with a matching composite FK, since 004's DROP CASCADE would remove
             any pre-existing settlements FK from 002. -->
        <sql>DROP TABLE IF EXISTS trades CASCADE;</sql>
        <sql>
            CREATE TABLE trades (
                id              BIGINT       NOT NULL,
                trade_ref       VARCHAR(30)  NOT NULL,
                instrument_id   BIGINT       NOT NULL,
                counterparty_id BIGINT       NOT NULL,
                asset_class     VARCHAR(20)  NOT NULL,
                side            VARCHAR(4)   NOT NULL,
                quantity        NUMERIC(18,4) NOT NULL,
                price           NUMERIC(18,4) NOT NULL,
                trade_date      DATE         NOT NULL,
                status          VARCHAR(20)  NOT NULL DEFAULT 'PENDING',
                deleted_at      TIMESTAMP,
                created_at      TIMESTAMP    NOT NULL DEFAULT CURRENT_TIMESTAMP,
                modified_at     TIMESTAMP    NOT NULL DEFAULT CURRENT_TIMESTAMP,
                CONSTRAINT pk_trades       PRIMARY KEY (id, trade_date),
                CONSTRAINT uk_trades_ref   UNIQUE (trade_ref, trade_date),
                CONSTRAINT fk_trades_instrument
                    FOREIGN KEY (instrument_id) REFERENCES instruments(id),
                CONSTRAINT fk_trades_counterparty
                    FOREIGN KEY (counterparty_id) REFERENCES counterparties(id)
            ) PARTITION BY RANGE (trade_date);
        </sql>
        <sql>CREATE INDEX idx_trades_trade_date ON trades (trade_date);</sql>
        <sql>CREATE INDEX idx_trades_status     ON trades (status);</sql>
        <rollback>
            <sql>DROP TABLE IF EXISTS trades CASCADE;</sql>
            <sql>
                CREATE TABLE trades (
                    id              BIGINT       NOT NULL,
                    trade_ref       VARCHAR(30)  NOT NULL,
                    instrument_id   BIGINT       NOT NULL,
                    counterparty_id BIGINT       NOT NULL,
                    asset_class     VARCHAR(20)  NOT NULL,
                    side            VARCHAR(4)   NOT NULL,
                    quantity        NUMERIC(18,4) NOT NULL,
                    price           NUMERIC(18,4) NOT NULL,
                    trade_date      DATE         NOT NULL,
                    status          VARCHAR(20)  NOT NULL DEFAULT 'PENDING',
                    deleted_at      TIMESTAMP,
                    created_at      TIMESTAMP    NOT NULL DEFAULT CURRENT_TIMESTAMP,
                    modified_at     TIMESTAMP    NOT NULL DEFAULT CURRENT_TIMESTAMP,
                    CONSTRAINT pk_trades_id PRIMARY KEY (id),
                    CONSTRAINT uk_trades_trade_ref UNIQUE (trade_ref)
                );
            </sql>
            <sql>CREATE INDEX idx_trades_trade_date ON trades (trade_date);</sql>
            <sql>CREATE INDEX idx_trades_status     ON trades (status);</sql>
        </rollback>
    </changeSet>

    <changeSet id="004-partition-child-tables" author="trainer">
        <preConditions onFail="MARK_RAN">
            <dbms type="postgresql"/>
        </preConditions>
        <sql>
            CREATE TABLE IF NOT EXISTS trades_2026_04
            PARTITION OF trades
            FOR VALUES FROM ('2026-04-01') TO ('2026-05-01');

            CREATE TABLE IF NOT EXISTS trades_2026_05
            PARTITION OF trades
            FOR VALUES FROM ('2026-05-01') TO ('2026-06-01');

            CREATE TABLE IF NOT EXISTS trades_2026_06
            PARTITION OF trades
            FOR VALUES FROM ('2026-06-01') TO ('2026-07-01');

            CREATE TABLE IF NOT EXISTS trades_2026_07
            PARTITION OF trades
            FOR VALUES FROM ('2026-07-01') TO ('2026-08-01');

            CREATE TABLE IF NOT EXISTS trades_default
            PARTITION OF trades
            DEFAULT;
        </sql>
        <rollback>
            <sql>
                DROP TABLE IF EXISTS trades_default;
                DROP TABLE IF EXISTS trades_2026_07;
                DROP TABLE IF EXISTS trades_2026_06;
                DROP TABLE IF EXISTS trades_2026_05;
                DROP TABLE IF EXISTS trades_2026_04;
            </sql>
        </rollback>
    </changeSet>

    <!-- ADV006 — settlements. Created here (after 004-partition-parent) rather
         than in 002-schema because the composite FK references the partitioned
         trades PK (id, trade_date), which only exists after 004 recreates
         trades. 004's DROP ... CASCADE would drop any pre-existing settlements
         FK anyway, so creation must follow partitioning. -->
    <changeSet id="004-create-settlements" author="trainer">
        <createTable tableName="settlements">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="trade_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="trade_date" type="DATE"><constraints nullable="false"/></column>
            <column name="settlement_date" type="DATE"><constraints nullable="false"/></column>
            <column name="amount" type="NUMERIC(18,4)"><constraints nullable="false"/></column>
            <column name="status" type="VARCHAR(20)" defaultValue="PENDING"><constraints nullable="false"/></column>
        </createTable>
        <addForeignKeyConstraint baseTableName="settlements" baseColumnNames="trade_id, trade_date"
                                 constraintName="fk_settlements_trade"
                                 referencedTableName="trades" referencedColumnNames="id, trade_date"/>
        <rollback>
            <dropTable tableName="settlements"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
